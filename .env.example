# Copy to .env and fill in. Never put provider keys (OpenAI/Anthropic) here: they live in Supabase secrets.

# Supabase (Project Settings → API). The anon key is public by design; RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Assistant: set to true once the `assistant` Edge Function is deployed with its secrets.
EXPO_PUBLIC_ASSISTANT_ENABLED=false
# Shown in the consent text, e.g. "Anthropic" or "OpenAI".
EXPO_PUBLIC_ASSISTANT_PROVIDER_NAME=
