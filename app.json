{
  "expo": {
    "name": "MORROW",
    "slug": "morrow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.morrow.life"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2F0EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.morrow.life"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "MORROW usa tus fotos para a\u00f1adir im\u00e1genes a tus dietas y recetas.",
          "cameraPermission": "MORROW usa la c\u00e1mara para fotografiar tus dietas y recetas."
        }
      ]
    ],
    "scheme": "morrow",
    "backgroundColor": "#F2F0EA",
    "experiments": {
      "typedRoutes": false
    }
  }
}